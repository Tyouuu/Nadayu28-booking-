# Copy this file to .env and fill in your actual values
# Get these from: https://supabase.com/dashboard -> Your Project -> Settings -> API

# ── Frontend (Vite, exposed to the browser) ────────────────────────────
# Supabase Project URL
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Supabase Anon (public) key - safe to use in frontend
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Only needed if the Vercel Serverless Functions run on a different origin
# than the frontend (rare). Leave unset for a normal Vercel deployment -
# /api/* is called as a relative path on the same domain.
# VITE_API_BASE_URL=

# ── Backend (Vercel Serverless Functions, server-side only) ────────────
# These must be set in the Vercel Project Settings -> Environment Variables,
# NOT prefixed with VITE_ (that prefix makes a value public in the browser
# bundle). The service role key bypasses Row Level Security, so it must
# never be shipped to the client.
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
